DATABASE_URL=postgresql://user:password@host/database?sslmode=require
SUPABASE_JWT_SECRET=your-legacy-hs256-secret-if-used
SUPABASE_URL=https://your-project.supabase.co
# Set to false once Supabase shows no HS256 sessions, then revoke the legacy secret.
ALLOW_LEGACY_HS256=true
# Backend only, never NEXT_PUBLIC_. When set, account deletion also deletes the Supabase sign-in.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=your-anthropic-api-key

ENVIRONMENT=development
MIGRATION_ALLOWED_HOST=
ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/gmail/callback
# Generate with Fernet.generate_key(); keep stable for the lifetime of stored Gmail tokens.
TOKEN_ENCRYPTION_KEY=your-fernet-key

DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT=10
DATABASE_CONNECT_TIMEOUT=10

# Optional opt-in reminder delivery. Configure a verified Resend sending domain.
RESEND_API_KEY=
REMINDER_EMAIL_FROM=
CRON_SECRET=

# Forwarded email from the Cloudflare Email Worker. An empty secret disables the endpoint.
INBOUND_EMAIL_SECRET=
INBOUND_EMAIL_DOMAIN=pocketday.app

# Supabase user IDs (comma-separated) allowed to use Gmail OAuth for owner testing. Empty = nobody.
GMAIL_OAUTH_USER_IDS=

# Guest demo. An empty secret disables it; production needs at least 64 characters.
DEMO_TOKEN_SECRET=
DEMO_SESSION_HOURS=24
DEMO_SESSIONS_PER_CLIENT_PER_HOUR=15
DEMO_SESSIONS_PER_HOUR=50
DEMO_AGENT_MESSAGES=20

# AI spend controls. AI features return 503 once today's recorded cost reaches the limit (0 disables).
AI_DAILY_COST_LIMIT_USD=20
ASSISTANT_RUNS_PER_DAY=100
